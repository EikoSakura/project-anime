<div class="pa-card pa-zone">
  <div class="chead">
    <div class="ctitle"><span class="cname zname">{{name}}</span></div>
  </div>
  <div class="zbody">
    {{#each effects}}
    <div class="zline">
      <span class="zkw">{{this.keyword}}</span>{{#if this.name}} <span class="zsep">·</span> <span class="zskin">{{this.name}}.</span>{{/if}}
      {{~#if this.text}} {{this.text}}{{/if}}
    </div>
    {{/each}}
  </div>
</div>
