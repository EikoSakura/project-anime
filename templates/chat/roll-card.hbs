<div class="pa-card">
  <div class="chead">
    <span class="cname">{{title}}</span>
  </div>
  <div class="cbody">
    <div class="dicerow">
      {{#each faces}}
      <span class="face{{#if this.lucky}} lucky{{/if}}" data-index="{{@index}}">{{this.value}}</span>
      {{/each}}
      <div class="rtotal">
        <span class="tlab">{{localize "PROJECTANIME.Roll.Total"}}</span>
        <span class="tnum">{{total}}</span>
      </div>
    </div>
    {{#if trait}}
    <div class="rtrait"><span class="rmark">◆</span><span>{{trait.name}} +{{trait.mod}}</span></div>
    {{/if}}
    {{#if bonus}}
    <div class="rtrait"><span class="rmark">◆</span><span>{{localize "PROJECTANIME.Roll.Bonus"}} {{bonus}}</span></div>
    {{/if}}
    {{#each luck}}
    <div class="rtrait luck"><span class="rmark">◆</span><span>{{this}}</span></div>
    {{/each}}
    {{#if openingArmed}}
    <div class="opening">
      <span class="oplab">{{localize "PROJECTANIME.Opening.Label"}}</span>
      <button type="button" class="opbtn" data-kind="energy">{{localize "PROJECTANIME.Opening.Energy"}}</button>
      <button type="button" class="opbtn" data-kind="luck">{{localize "PROJECTANIME.Opening.Luck"}}</button>
    </div>
    {{/if}}
    {{#if openingLine}}
    <div class="rtrait"><span class="rmark">◆</span><span>{{openingLine}}</span></div>
    {{/if}}
  </div>
</div>
