<div class="pa-card">
  <div class="chead">
    <span class="cname">{{title}}</span>
  </div>
  <div class="cbody">
    <div class="dicerow">
      {{#each faces}}
      <span class="face{{#if this.lucky}} lucky{{/if}}" data-index="{{@index}}">{{this.value}}</span>
      {{/each}}
      <div class="rtotal">
        <span class="tlab">{{localize "PROJECTANIME.Roll.Total"}}</span>
        <span class="tnum">{{total}}</span>
      </div>
    </div>
    {{#if trait}}
    <div class="rtrait"><span class="rmark">◆</span><span>{{trait.name}} +{{trait.mod}}</span></div>
    {{/if}}
    {{#if bonus}}
    <div class="rtrait"><span class="rmark">◆</span><span>{{localize "PROJECTANIME.Roll.Bonus"}} {{bonus}}</span></div>
    {{/if}}
    {{#each luck}}
    <div class="rtrait luck"><span class="rmark">◆</span><span>{{this}}</span></div>
    {{/each}}
    {{#each openings}}
    <div class="rtrait"><span class="rmark">◆</span><span>{{this}}</span></div>
    {{/each}}
    {{#if band}}
    <div class="dband">
      <span class="gtag" style="--gc: var({{band.cssVar}})"><b>{{band.rank}}</b><small>{{band.number}}</small></span>
      <span class="bword{{#if band.fumble}} fumble{{/if}}">{{band.word}}</span>
      {{#if band.limitBreak}}<span class="lbtag">{{band.limitBreak}}</span>{{/if}}
    </div>
    {{/if}}
    {{#if band.riders.length}}
    <div class="riders">
      {{#each band.riders}}<div data-rider="{{this.key}}">{{this.text}}</div>{{/each}}
    </div>
    {{/if}}
  </div>
</div>
