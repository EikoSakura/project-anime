<section class="tab profile {{tab.cssClass}}" data-group="primary" data-tab="profile">
  <div class="panel">
    <div class="panel-h"><span class="en">{{localize "PROJECTANIME.Panel.Background"}}</span></div>
    <div class="panel-b">
      {{#if editMode}}
      <div class="pgrid">
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Header.Age"}}</div>
          <input class="ed-input" type="text" name="system.age" value="{{system.age}}">
        </div>
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Profile.Gender"}}</div>
          <input class="ed-input" type="text" name="system.gender" value="{{system.gender}}">
        </div>
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Profile.Pronouns"}}</div>
          <input class="ed-input" type="text" name="system.pronouns" value="{{system.pronouns}}">
        </div>
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Header.Player"}}</div>
          <input class="ed-input" type="text" name="system.player" value="{{system.player}}">
        </div>
      </div>
      <div class="field">
        <div class="flabel">{{localize "PROJECTANIME.Profile.Personality"}}</div>
        <textarea class="ed-area" name="system.personality">{{system.personality}}</textarea>
      </div>
      <div class="field">
        <div class="flabel">{{localize "PROJECTANIME.Profile.History"}}</div>
        <textarea class="ed-area" name="system.history">{{system.history}}</textarea>
      </div>
      <div class="field">
        <div class="flabel">{{localize "PROJECTANIME.Profile.Notes"}}</div>
        <textarea class="ed-area" name="system.notes">{{system.notes}}</textarea>
      </div>
      {{else}}
      <div class="pgrid">
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Header.Age"}}</div>
          <div class="fval">{{#if system.age}}{{system.age}}{{else}}<span class="empty">·</span>{{/if}}</div>
        </div>
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Profile.Gender"}}</div>
          <div class="fval">{{#if system.gender}}{{system.gender}}{{else}}<span class="empty">·</span>{{/if}}</div>
        </div>
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Profile.Pronouns"}}</div>
          <div class="fval">{{#if system.pronouns}}{{system.pronouns}}{{else}}<span class="empty">·</span>{{/if}}</div>
        </div>
        <div class="field">
          <div class="flabel">{{localize "PROJECTANIME.Header.Player"}}</div>
          <div class="fval">{{#if system.player}}{{system.player}}{{else}}<span class="empty">·</span>{{/if}}</div>
        </div>
      </div>
      <div class="field">
        <div class="flabel">{{localize "PROJECTANIME.Profile.Personality"}}</div>
        <div class="fval long">{{#if system.personality}}{{system.personality}}{{else}}<span class="empty">·</span>{{/if}}</div>
      </div>
      <div class="field">
        <div class="flabel">{{localize "PROJECTANIME.Profile.History"}}</div>
        <div class="fval long">{{#if system.history}}{{system.history}}{{else}}<span class="empty">·</span>{{/if}}</div>
      </div>
      <div class="field">
        <div class="flabel">{{localize "PROJECTANIME.Profile.Notes"}}</div>
        <div class="fval long">{{#if system.notes}}{{system.notes}}{{else}}<span class="empty">·</span>{{/if}}</div>
      </div>
      {{/if}}
    </div>
  </div>
</section>
