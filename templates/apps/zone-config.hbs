<div class="zc-body">
  <div class="zc-obi">
    <span class="zc-name">{{name}}</span>
    <span class="zc-dot" style="background: {{tint}}"></span>
  </div>
  <div class="zc-sec">{{localize "PROJECTANIME.Zone.Effects"}}</div>
  {{#each effects}}
  <div class="zc-fx">
    <div class="zc-r1">
      <select name="system.effects.{{this.index}}.keyword">
        {{#each this.keywords}}
        <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
      <input type="text" name="system.effects.{{this.index}}.name" value="{{this.name}}">
      <button type="button" class="zc-del" data-action="removeEffect" data-index="{{this.index}}"
              title="{{localize 'PROJECTANIME.Zone.Remove'}}">&#10005;</button>
    </div>
    <input type="text" class="zc-text" name="system.effects.{{this.index}}.text" value="{{this.text}}">
  </div>
  {{/each}}
  <button type="button" class="zc-add" data-action="addEffect">{{localize "PROJECTANIME.Zone.AddEffect"}}</button>
  <div class="zc-foot">
    <label class="zc-show">
      <input type="checkbox" name="system.showPlate"{{#if showPlate}} checked{{/if}}>
      <span>{{localize "PROJECTANIME.Zone.ShowPlate"}}</span>
    </label>
    <div class="zc-tints">
      <span class="zc-tl">{{localize "PROJECTANIME.Zone.Tint"}}</span>
      {{#each tints}}
      <button type="button" class="zc-tint{{#if this.selected}} sel{{/if}}" data-action="tint"
              data-color="{{this.color}}" style="background: {{this.color}}"></button>
      {{/each}}
    </div>
  </div>
</div>
