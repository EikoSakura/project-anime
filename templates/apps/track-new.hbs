<div class="trackdlg">
<div class="dbody">
  <div class="slab">{{localize "PROJECTANIME.Tracks.Name"}}</div>
  <input type="text" class="dtext" name="name" required autofocus aria-label="{{localize "PROJECTANIME.Tracks.Name"}}">
  <div class="lenrow">
    <div class="slab">{{localize "PROJECTANIME.Tracks.Segments"}}</div>
    <input type="number" class="dtext" name="len" value="6" min="2" max="12" step="1" aria-label="{{localize "PROJECTANIME.Tracks.Segments"}}">
  </div>
  <label class="ckrow">
    <input type="checkbox" name="contest">
    <span>{{localize "PROJECTANIME.Tracks.Contest"}}</span>
  </label>
  <fieldset class="sidesbox" hidden disabled>
    <div class="slab">{{localize "PROJECTANIME.Tracks.Sides"}}</div>
    <div class="siderows">
      <div class="siderow">
        <input type="text" class="dtext" name="sname" required aria-label="{{localize "PROJECTANIME.Tracks.Name"}}">
        <input type="number" class="dtext snum" name="slen" value="6" min="2" max="12" step="1" aria-label="{{localize "PROJECTANIME.Tracks.Segments"}}">
      </div>
      <div class="siderow">
        <input type="text" class="dtext" name="sname" required aria-label="{{localize "PROJECTANIME.Tracks.Name"}}">
        <input type="number" class="dtext snum" name="slen" value="6" min="2" max="12" step="1" aria-label="{{localize "PROJECTANIME.Tracks.Segments"}}">
      </div>
    </div>
    <button type="button" class="addside" data-action="addSide">{{localize "PROJECTANIME.Tracks.AddSide"}}</button>
  </fieldset>
</div>
<div class="dfoot">
  <button type="submit" class="savebtn">{{localize "PROJECTANIME.Tracks.Create"}}</button>
</div>
</div>
