<div class="lpick">
  <div class="lprow">
    <span class="lpdice">
      {{#each dice}}
      <span class="stepgrp">
        <button type="button" class="stepbtn" data-action="shift" data-die="{{this.index}}" data-delta="-1"{{#if this.downDisabled}} disabled{{/if}}>&#9660;</button>
        <span class="lpdie static">{{this.value}}</span>
        <button type="button" class="stepbtn" data-action="shift" data-die="{{this.index}}" data-delta="1"{{#if this.upDisabled}} disabled{{/if}}>&#9650;</button>
      </span>
      {{/each}}
    </span>
  </div>
</div>
